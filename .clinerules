## 🔄 CI/CD Pipeline

### Strategy
- **Platform:** GitHub Actions
- **Environments:** `development` → `preview` (per PR) → `production` (main branch)
- **Hosting:** Vercel (production + preview deployments)
- **Registry:** GitHub Container Registry (optional, for Docker-based jobs)

---

### Branch Strategy (GitFlow simplified)

```
main          → auto-deploys to production (vercel --prod)
develop       → integration branch, deploys to staging preview
feat/*        → PR to develop → triggers CI checks + Vercel preview URL
fix/*         → PR to develop or main depending on severity
release/*     → bump version, merge to main + tag
```

---

### GitHub Actions Workflows

#### 1. `ci.yml` — Runs on every PR and push to `develop`/`main`

```yaml
# .github/workflows/ci.yml
name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  lint-and-type-check:
    name: Lint & Type Check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - run: npm run lint
      - run: npm run type-check        # tsc --noEmit

  test:
    name: Unit & Integration Tests
    runs-on: ubuntu-latest
    needs: lint-and-type-check
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: test
          POSTGRES_PASSWORD: test
          POSTGRES_DB: zayan_test
        ports: ['5432:5432']
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    env:
      DATABASE_URL: postgresql://test:test@localhost:5432/zayan_test
      NEXTAUTH_SECRET: ci-secret-do-not-use
      NEXTAUTH_URL: http://localhost:3000
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - run: npx prisma migrate deploy
      - run: npm test -- --coverage     # Vitest

  build:
    name: Build Check
    runs-on: ubuntu-latest
    needs: lint-and-type-check
    env:
      DATABASE_URL: ${{ secrets.DATABASE_URL_CI }}
      NEXTAUTH_SECRET: ${{ secrets.NEXTAUTH_SECRET }}
      NEXTAUTH_URL: http://localhost:3000
      GOOGLE_PLACES_API_KEY: placeholder
      GOOGLE_PLACE_ID: placeholder
      UPLOADTHING_SECRET: placeholder
      RESEND_API_KEY: placeholder
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - run: npx prisma generate
      - run: npm run build
```

---

#### 2. `preview.yml` — Vercel Preview per PR

```yaml
# .github/workflows/preview.yml
name: Preview Deployment

on:
  pull_request:
    branches: [develop, main]

jobs:
  deploy-preview:
    name: Deploy to Vercel Preview
    runs-on: ubuntu-latest
    environment: preview
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - name: Deploy Preview
        id: deploy
        run: |
          DEPLOY_URL=$(npx vercel deploy \
            --token=${{ secrets.VERCEL_TOKEN }} \
            --env DATABASE_URL="${{ secrets.DATABASE_URL_PREVIEW }}" \
            --env NEXTAUTH_SECRET="${{ secrets.NEXTAUTH_SECRET }}" \
            --env NEXTAUTH_URL="${{ steps.deploy.outputs.url }}" \
            --yes 2>&1 | tail -1)
          echo "url=$DEPLOY_URL" >> $GITHUB_OUTPUT
      - name: Comment Preview URL on PR
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `✅ **Preview deployed:** ${{ steps.deploy.outputs.url }}`
            })
```

---

#### 3. `deploy.yml` — Production Deploy on merge to `main`

```yaml
# .github/workflows/deploy.yml
name: Production Deployment

on:
  push:
    branches: [main]

jobs:
  migrate:
    name: Run DB Migrations
    runs-on: ubuntu-latest
    environment: production
    env:
      DATABASE_URL: ${{ secrets.DATABASE_URL_PROD }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - run: npx prisma migrate deploy

  deploy-production:
    name: Deploy to Vercel Production
    runs-on: ubuntu-latest
    needs: migrate
    environment: production
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - run: npx vercel deploy --prod --token=${{ secrets.VERCEL_TOKEN }} --yes

  notify:
    name: Slack / Discord Notify
    runs-on: ubuntu-latest
    needs: deploy-production
    if: always()
    steps:
      - name: Notify on success
        if: needs.deploy-production.result == 'success'
        run: |
          curl -X POST ${{ secrets.SLACK_WEBHOOK_URL }} \
          -H 'Content-type: application/json' \
          -d '{"text":"✅ *Zayan Travels* deployed to production successfully!"}'
      - name: Notify on failure
        if: needs.deploy-production.result == 'failure'
        run: |
          curl -X POST ${{ secrets.SLACK_WEBHOOK_URL }} \
          -H 'Content-type: application/json' \
          -d '{"text":"❌ *Zayan Travels* production deployment FAILED. Check GitHub Actions."}'
```

---

#### 4. `release.yml` — Semantic Versioning + Changelog

```yaml
# .github/workflows/release.yml
name: Release

on:
  push:
    branches: [main]

jobs:
  release:
    name: Semantic Release
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      - run: npm ci
      - run: npx semantic-release
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
```

Add `release.config.js`:
```js
// release.config.js
export default {
  branches: ['main'],
  plugins: [
    '@semantic-release/commit-analyzer',
    '@semantic-release/release-notes-generator',
    '@semantic-release/changelog',
    '@semantic-release/github',
    ['@semantic-release/git', {
      assets: ['CHANGELOG.md', 'package.json'],
      message: 'chore(release): ${nextRelease.version} [skip ci]'
    }]
  ]
}
```

